// ==========================================
// 5. SETUP E ROTAS DO SERVIDOR
// ==========================================
void setup() {
  Serial.begin(115200);
  
  pinMode(IN1_LE, OUTPUT); pinMode(IN2_LE, OUTPUT); pinMode(IN3_LE, OUTPUT); pinMode(IN4_LE, OUTPUT);
  pinMode(IN1_LD, OUTPUT); pinMode(IN2_LD, OUTPUT); pinMode(IN3_LD, OUTPUT); pinMode(IN4_LD, OUTPUT);

  pinMode(SENSOR_FRENTE_ESQ, INPUT);
  pinMode(SENSOR_FRENTE_DIR, INPUT);
  pinMode(SENSOR_TRAS_ESQ, INPUT);
  pinMode(SENSOR_TRAS_DIR, INPUT);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  // Inicia o Servo e põe ele olhando para frente (90 graus)
  pescoco.attach(SERVO_PIN);
  pescoco.write(90);

  WiFi.softAP(ssid);
  Serial.print("IP do Carro: "); Serial.println(WiFi.softAPIP());

  server.on("/", []() { server.send(200, "text/html", HTML_PAGINA); });
  
  server.on("/setmode", []() {
    String mode = server.arg("mode");
    if (mode == "auto") {
      modoAutonomo = true;
    } else {
      modoAutonomo = false;
      parar();
    }
    server.send(200, "text/plain", "OK");
  });
  
  server.on("/move", []() {
    if(!modoAutonomo) { 
      String dir = server.arg("dir");
      if (dir == "frente") irFrente(velManual);
      else if (dir == "tras") irTras(velManual);
      else if (dir == "esquerda") virarEsquerda(velManual);
      else if (dir == "direita") virarDireita(velManual);
    }
    server.send(200, "text/plain", "OK");
  });

  server.on("/stop", []() {
    parar();
    server.send(200, "text/plain", "OK");
  });

  server.begin();
  parar(); 
}

// ==========================================
// 6. FUNÇÃO DO SENSOR ULTRASSÔNICO
// ==========================================
long medirDistancia() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  long duracao = pulseIn(ECHO_PIN, HIGH, 30000); 
  if (duracao == 0) return 999; 
  
  return duracao * 0.034 / 2;
}

// ==========================================
// 7. LÓGICA DO PILOTO AUTOMÁTICO (RADAR ATIVO)
// ==========================================
void pilotoAutomatico() {
  // Garante que está olhando pra frente
  pescoco.write(90);
  delay(50); // Pausa pequena para estabilizar
  
  long distanciaFrente = medirDistancia();
  
  // 1º PRIORIDADE MÁXIMA: PAREDE À FRENTE
  if (distanciaFrente < 20) {
    parar(); // Freia imediatamente
    
    // Olha pra Direita
    pescoco.write(30); 
    delay(400); // Dá tempo pro servo girar fisicamente
    long distanciaDireita = medirDistancia();
    
    // Olha pra Esquerda
    pescoco.write(150);
    delay(500); // Gira pro outro lado
    long distanciaEsquerda = medirDistancia();
    
    // Volta a olhar pra frente
    pescoco.write(90);
    delay(300);

    // Dá uma pequena ré de segurança
    irTras(velAutoReto);
    delay(300);

    // Toma a Decisão de qual lado ir
    if (distanciaDireita >= distanciaEsquerda) {
      virarDireita(velAutoCurva);
      delay(400); // Gira o carro
    } else {
      virarEsquerda(velAutoCurva);
      delay(400); // Gira o carro
    }
    
    return; // Encerra esse ciclo para ler a pista de novo
  }

  // 2º PRIORIDADE: SE NÃO TEM PAREDE, SEGUE AS LINHAS PRETAS (IR)
  int lerFrenteEsq = digitalRead(SENSOR_FRENTE_ESQ);
  int lerFrenteDir = digitalRead(SENSOR_FRENTE_DIR);
  
  if (lerFrenteEsq == CHAO_CLARO && lerFrenteDir == CHAO_CLARO) {
    irFrente(velAutoReto);
  } 
  else if (lerFrenteEsq == LINHA_PRETA && lerFrenteDir == CHAO_CLARO) {
    virarDireita(velAutoCurva);
  } 
  else if (lerFrenteDir == LINHA_PRETA && lerFrenteEsq == CHAO_CLARO) {
    virarEsquerda(velAutoCurva);
  } 
  else {
    irTras(velAutoReto);
  }
}

// ==========================================
// 8. FUNÇÕES DE MOVIMENTO
// ==========================================
void irFrente(int vel) {
  analogWrite(IN1_LE, vel); analogWrite(IN2_LE, 0);
  analogWrite(IN3_LE, vel); analogWrite(IN4_LE, 0);
  analogWrite(IN1_LD, vel); analogWrite(IN2_LD, 0);
  analogWrite(IN3_LD, vel); analogWrite(IN4_LD, 0);
}

void irTras(int vel) {
  analogWrite(IN1_LE, 0); analogWrite(IN2_LE, vel);
  analogWrite(IN3_LE, 0); analogWrite(IN4_LE, vel);
  analogWrite(IN1_LD, 0); analogWrite(IN2_LD, vel);
  analogWrite(IN3_LD, 0); analogWrite(IN4_LD, vel);
}

void virarEsquerda(int vel) {
  analogWrite(IN1_LE, 0); analogWrite(IN2_LE, vel);
  analogWrite(IN3_LE, 0); analogWrite(IN4_LE, vel);
  analogWrite(IN1_LD, vel); analogWrite(IN2_LD, 0);
  analogWrite(IN3_LD, vel); analogWrite(IN4_LD, 0);
}

void virarDireita(int vel) {
  analogWrite(IN1_LE, vel); analogWrite(IN2_LE, 0);
  analogWrite(IN3_LE, vel); analogWrite(IN4_LE, 0);
  analogWrite(IN1_LD, 0); analogWrite(IN2_LD, vel);
  analogWrite(IN3_LD, 0); analogWrite(IN4_LD, vel);
}

void parar() {
  analogWrite(IN1_LE, 0); analogWrite(IN2_LE, 0);
  analogWrite(IN3_LE, 0); analogWrite(IN4_LE, 0);
  analogWrite(IN1_LD, 0); analogWrite(IN2_LD, 0);
  analogWrite(IN3_LD, 0); analogWrite(IN4_LD, 0);
}

// ==========================================
// 9. LOOP PRINCIPAL
// ==========================================
void loop() {
  server.handleClient();

  if (modoAutonomo) {
    pilotoAutomatico();
  }
}