// 1. PINOS DOS MOTORES (PONTE H)
// ==========================================
const int IN1_LE = 26; const int IN2_LE = 2; 
const int IN3_LE = 27; const int IN4_LE = 13; 
const int IN1_LD = 32; const int IN2_LD = 4;  
const int IN3_LD = 23; const int IN4_LD = 19; 

// ==========================================
// 2. PINOS DOS SENSORES
// ==========================================
// Infravermelhos
const int SENSOR_FRENTE_ESQ = 14; 
const int SENSOR_FRENTE_DIR = 15; 
const int SENSOR_TRAS_ESQ = 33;   
const int SENSOR_TRAS_DIR = 25;   

#define LINHA_PRETA HIGH 
#define CHAO_CLARO LOW

// Ultrassônico e Servo ("O Pescoço")
const int TRIG_PIN = 5;
const int ECHO_PIN = 18;
const int SERVO_PIN = 16; 

Servo pescoco; // Cria o objeto do Servo Motor

// ==========================================
// 3. CONTROLE DE VELOCIDADES SEPARADAS
// ==========================================
int velManual = 180;      
int velAutoReto = 90;     
int velAutoCurva = 110;   

bool modoAutonomo = false;

WebServer server(80);
const char* ssid = "VADE_Car_Controller";

